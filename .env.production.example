# Variáveis do portal do Codex em PRODUÇÃO (004). Valores fictícios.
#
# ATENÇÃO: `VITE_*` é substituído DENTRO DO BUNDLE durante o build (decisão D1 do PRD). Estes
# valores viram `--build-arg` do `docker build`, não variáveis do container em runtime — trocá-los
# depois não muda nada no que já foi construído. E, por estarem no bundle, são PÚBLICOS: nunca
# ponha segredo aqui (`VITE_` é legível por qualquer visitante).

VITE_API_URL=https://codex-api.exemplo.com.br/api/v1
VITE_APP_NAME=Codex

VITE_KEYCLOAK_URL=https://auth.exemplo.com.br
VITE_KEYCLOAK_REALM=troque-me
VITE_KEYCLOAK_CLIENT_ID=codex-front

# --- Runtime do container (estas SÃO lidas em runtime, pelo nginx) ------------------------------
# Origens que o navegador pode contatar, além da própria: a API e o Keycloak. Entram na diretiva
# `connect-src` da CSP. Sem elas, o próprio login é bloqueado pela política.
CSP_CONNECT_SRC=https://codex-api.exemplo.com.br https://auth.exemplo.com.br
